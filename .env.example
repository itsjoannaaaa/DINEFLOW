# Copy to .env. Never share or commit the completed .env file.
HOST=127.0.0.1
PORT=4173
APP_URL=http://127.0.0.1:4173
DB_PATH=./data/dineflow.sqlite
RESTAURANT_TIMEZONE=Asia/Manila
# Set true only behind HTTPS. Required when HOST is not loopback.
COOKIE_SECURE=false
# Required for remote first-time setup; use a long random value.
SETUP_SECRET=

# Personal Gmail: enable 2-Step Verification, then create a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Example: MAIL_FROM="DineFlow <your-new-address@gmail.com>"
